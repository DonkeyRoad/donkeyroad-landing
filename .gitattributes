# Normalize line endings: text files use LF in the repo, native on checkout.
* text=auto

# Binary assets — never diff or line-ending-convert these.
*.png    binary
*.jpg    binary
*.jpeg   binary
*.webp   binary
*.avif   binary
*.gif    binary
*.ico    binary
*.mp4    binary
*.webm   binary
*.woff   binary
*.woff2  binary
*.ttf    binary
*.otf    binary
*.pdf    binary
